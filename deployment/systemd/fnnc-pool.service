[Unit]
Description=Fennec pool: stratum server (miners, share checking with the yescrypt helper, block submission)
After=fnnc-pool-redis.service fnnc-node.service
Requires=fnnc-pool-redis.service
[Service]
Type=simple
User=fnncpool
WorkingDirectory=/opt/fnnc-nodejs-pool
ExecStart=/usr/bin/node /opt/fnnc-nodejs-pool/init.js -module=pool
Restart=always
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
# ports below 1024 need this:
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
