[Unit]
Description=Fennec node (fennecd): the chain, the block templates and the pool wallet
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=fnncpool
# fennec.conf: server=1, listen=1, rpcuser/rpcpassword, rpcbind=127.0.0.1, rpcport=8339, port=8338, addnode=<peers>, see docs/INSTALL.md
ExecStart=/opt/fnnc/bin/fennecd -datadir=/opt/fnnc/data -conf=/opt/fnnc/data/fennec.conf -printtoconsole
Restart=on-failure
RestartSec=30
LimitNOFILE=65536
TimeoutStopSec=180
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
