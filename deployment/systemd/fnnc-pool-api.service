[Unit]
Description=Fennec pool: public API (127.0.0.1:8127)
After=fnnc-pool-redis.service fnnc-node.service
Requires=fnnc-pool-redis.service
[Service]
Type=simple
User=fnncpool
WorkingDirectory=/opt/fnnc-nodejs-pool
ExecStart=/usr/bin/node /opt/fnnc-nodejs-pool/init.js -module=api
Restart=always
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
